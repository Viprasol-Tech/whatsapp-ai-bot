# Part of WhatsApp AI Bot by Viprasol Tech Private Limited (https://viprasol.com).
# Copy to ".env" and fill in real values. All variables are optional — with
# none set, the bot runs fully offline using the bundled deterministic fakes.

# Token you set in the Meta App dashboard for the webhook verification handshake.
WAB_VERIFY_TOKEN=dev-verify-token

# WhatsApp Cloud API credentials (from Meta for Developers > WhatsApp > API Setup).
WAB_WHATSAPP_ACCESS_TOKEN=
WAB_WHATSAPP_PHONE_NUMBER_ID=
WAB_GRAPH_API_VERSION=v21.0

# Set to true (with the credentials above) to send real messages via the
# WhatsApp Cloud API instead of the offline fake client.
WAB_USE_REAL_WHATSAPP=false

# Display name the assistant uses in replies.
WAB_BOT_NAME=Viprasol Assistant
